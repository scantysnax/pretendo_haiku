SOURCES 	:= $(CPP_FILES) $(ASM_FILES)
RESOURCES 	:= src/haiku/pretendo.rsrc
OBJECTS 	:= $(CPP_FILES:.cpp=.o) $(ASM_FILES:.asm=.o)
                
.SUFFIXES: .cpp .h .asm .o

.cpp.o:
	@echo compiling $<...
	@$(CPP) $(CPPFLAGS) $(DEFINES) -c $< -o $@ 1>/dev/null
		
.asm.o:
	@echo assembling $<...
	@$(ASM) $(ASMFLAGS) $(DEFINES) $< -o $@ 1>/dev/null


$(APPNAME): $(OBJECTS)
	@echo linking $@...
	@$(LD) $(LDFLAGS) $(OBJECTS) -o $@ 1>/dev/null
	@echo stripping $@...
	@$(STRIP) $@
	@echo adding resources to $@...
	@$(RES) -o $@ $(RESOURCES)
	@echo done.


.PHONY: clean 
clean:
	@echo cleaning...
	@$(RM) $(OBJECTS) $(APPNAME)
	@echo done.
	

