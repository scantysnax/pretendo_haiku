
APPNAME := Pretendo	

ASM    := nasm
CPP    := clang
LD     := clang
RM     := rm -f
RES	   := xres
STRIP  := strip

DEFINES  := 
INCLUDES := -Ilibines2/lib/include/ -Isrc/ -Isrc/haiku/ \
		 	-I/boot/system/develop/headers/x86 \
		 	-I/boot/system/develop/headers/x86/libxml2

ASMFLAGS := -f elf
CPPFLAGS := -O3 $(INCLUDES) -W -Wall -Wno-implicit-fallthrough -std=c++17 #-flto
LDFLAGS  := -L/boot/common/lib \
			-lbe -lroot -ltranslation -ltracker -lgame -lmedia -lxml2 -lz -lstdc++ #-flto

ASM_FILES := \
	src/asm/blitters_x86.asm \
	src/asm/copies_x86.asm

